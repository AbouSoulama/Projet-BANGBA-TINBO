# Public site URL used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL (Hostinger / phpMyAdmin). On Hostinger, from the app use 127.0.0.1 — not the remote srv host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Required for form emails. Gmail needs an app password (Google Account → Security → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tinbobangba@gmail.com
# SMTP_PASS=
# SMTP_FROM=tinbobangba@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=tinbobangba@gmail.com
