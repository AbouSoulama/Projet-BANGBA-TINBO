# Public site URL used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL (Hostinger / phpMyAdmin). On Hostinger, from the app use 127.0.0.1 — not the remote srv host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional SMTP. If MySQL is set, leads are stored even without mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=bangbatinbo@gmail.com
